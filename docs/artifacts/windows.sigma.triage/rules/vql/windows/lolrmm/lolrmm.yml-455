title: RMM RemoteCall (filesystem)
description: |
   RemoteCall is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - rcengmgru.exe
     - rcmgrsvc.exe
     - rxstartsupport.exe
     - rcstartsupport.exe
     - raautoup.exe
     - agentu.exe
     - remotesupportplayeru.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
