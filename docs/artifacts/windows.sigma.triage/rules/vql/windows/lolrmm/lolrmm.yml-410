title: RMM ngrok (filesystem)
description: |
   ngrok is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - ngrok.exe
   - OSPath|re:
     - C:\\.*\\ngrok.zip
     - .*\\ngrok.*

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
