title: RMM LANDesk (filesystem)
description: |
   LANDesk is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - issuser.exe
     - landeskagentbootstrap.exe
     - LANDeskPortalManager.exe
     - ldinv32.exe
     - ldsensors.exe
   - OSPath|re:
     - C:\\Program Files (x86)\\LANDesk\\.*
     - .*\\LANDesk\\.*
     - .*\\issuser.exe
     - .*\\softmon.exe
     - .*\\tmcsvc.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
