title: RMM Lite Manager (filesystem)
description: |
   Lite Manager is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - OSPath|re:
     - C:\\Program Files\\LiteManager Pro – Viewer\\.*
     - .*\\LiteManager Pro – Viewer\\.*
     - .*\\LMNoIpServer.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
