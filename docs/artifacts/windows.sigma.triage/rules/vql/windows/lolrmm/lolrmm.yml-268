title: RMM mstsc (filesystem)
description: |
   mstsc is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - C:\Windows\System32\mstsc.exe
   - OSPath|re:
     - .*Windows\\System32\\mstsc.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
