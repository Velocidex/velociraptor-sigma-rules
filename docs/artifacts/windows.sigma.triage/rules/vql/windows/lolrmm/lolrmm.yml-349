title: RMM Manage Engine (Desktop Central) (filesystem)
description: |
   Manage Engine (Desktop Central) is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - dcagentservice.exe
     - dcagentregister.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
