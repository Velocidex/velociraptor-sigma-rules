title: RMM Splashtop (Beta) (filesystem)
description: |
   Splashtop (Beta) is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - SRServer.exe
     - SplashtopSOS.exe
     - SRManager.exe
   - OSPath|re:
     - Splashtop_Streamer_Windows.*.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
