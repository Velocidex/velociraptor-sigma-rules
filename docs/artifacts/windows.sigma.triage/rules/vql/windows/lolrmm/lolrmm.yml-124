title: RMM Splashtop Remote (Pslist)
description: |
   Splashtop Remote is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: process_creation
  product: windows
  service: pslist

detection:
  condition: selection
  selection:
   - Image|endswith:
     - \strwinclt.exe
     - \SplashtopSOS.exe
     - \sragent.exe
     - \srmanager.exe
     - \srserver.exe
     - \srservice.exe
   - Image|re:
     - Splashtop_Streamer_Windows.*.exe

details: Detected RMM process %EventData.Image%
enrichment: |
  x=>dict(
   CallChain=GetCallChain(Pid=x.EventData.Pid),
   ImageHash=x.EventData.Image && hash(path=x.EventData.Image),
   ParentHash=x.EventData.ParentImage && hash(path=x.EventData.ParentImage))
