title: RMM Goverlan (Pslist)
description: |
   Goverlan is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: process_creation
  product: windows
  service: pslist

detection:
  condition: selection
  selection:
   - Image|endswith:
     - \goverrmc.exe
     - \GovAgentInstallHelper.exe
     - \GovAgentx64.exe
     - \GovReachClient.exe
   - Image|re:
     - govsrv.*.exe
     - C:\\Program Files (x86)\\PJ Technologies\\GOVsrv\\.*
     - .*\\PJ Technologies\\GOVsrv\\.*
     - .*\\GovSrv.exe

details: Detected RMM process %EventData.Image%
enrichment: |
  x=>dict(
   CallChain=GetCallChain(Pid=x.EventData.Pid),
   ImageHash=x.EventData.Image && hash(path=x.EventData.Image),
   ParentHash=x.EventData.ParentImage && hash(path=x.EventData.ParentImage))
