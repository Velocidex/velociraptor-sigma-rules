title: RMM Bitvise SSH Server (filesystem)
description: |
   Bitvise SSH Server is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - OSPath|re:
     - C:\\Program Files\\Bitvise SSH Server\\.*
     - .*\\Bitvise SSH Server\\.*
     - .*\\BvSshServer-Inst.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
