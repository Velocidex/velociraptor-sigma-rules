title: RMM BeAnyWhere (filesystem)
description: |
   BeAnyWhere is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - basuptshelper.exe
     - basupsrvcupdate.exe
     - BASupApp.exe
     - BASupSysInf.exe
     - BASupAppSrvc.exe
     - TakeControl.exe
     - BASupAppElev.exe
     - basupsrvc.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
