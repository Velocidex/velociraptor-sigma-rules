title: RMM Sophos-Remote Management System (filesystem)
description: |
   Sophos-Remote Management System is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - clientmrinit.exe
     - mgntsvc.exe
     - routernt.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
