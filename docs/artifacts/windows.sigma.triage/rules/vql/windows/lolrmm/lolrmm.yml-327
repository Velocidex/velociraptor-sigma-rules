title: RMM QQ IM-remote assistance (filesystem)
description: |
   QQ IM-remote assistance is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - qq.exe
     - QQProtect.exe
     - qqpcmgr.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
