title: RMM Duplicati (filesystem)
description: |
   Duplicati is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - OSPath|re:
     - c:\\Program Files\\.*\\Duplicati.Server.exe
     - .*\\.*\\Duplicati.Server.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
