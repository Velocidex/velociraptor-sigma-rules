title: RMM MEGAsync (filesystem)
description: |
   MEGAsync is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - OSPath|re:
     - C:\\Users\\.*\\AppData\\Local\\MEGAsync\\.*
     - .*Users\\.*\\AppData\\Local\\MEGAsync\\.*
     - .*ProgramData\\MEGAsync\\.*
     - .*\\MEGAsyncSetup64.exe
     - .*\\MEGAupdater.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
