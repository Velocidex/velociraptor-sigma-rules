title: RMM DameWare (Pslist)
description: |
   DameWare is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: process_creation
  product: windows
  service: pslist

detection:
  condition: selection
  selection:
   - Image|endswith:
     - \dwrcs.exe
     - \DameWare Remote Support.exe
   - Image|re:
     - SolarWinds-Dameware-DRS.*.exe
     - DameWare Mini Remote Control.*.exe
     - C:\\Windows\\dwrcs\\.*
     - C:\\Program Files\\SolarWinds\\Dameware Mini Remote Control\\.*
     - dntus.*.exe
     - .*\\dwrcs\\.*
     - .*\\dwrcst.exe
     - SolarWinds-Dameware-MRC.*.exe

details: Detected RMM process %EventData.Image%
enrichment: |
  x=>dict(
   CallChain=GetCallChain(Pid=x.EventData.Pid),
   ImageHash=x.EventData.Image && hash(path=x.EventData.Image),
   ParentHash=x.EventData.ParentImage && hash(path=x.EventData.ParentImage))
