title: RMM Insync (filesystem)
description: |
   Insync is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - C:\Users\USERNAME\AppData\Roaming\Insync\App\Insync.exe
   - OSPath|re:
     - .*Users\\.*\\AppData\\Roaming\\Insync\\App\\Insync.exe
     - .*\\Insync.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
