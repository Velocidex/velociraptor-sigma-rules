title: RMM Netop (filesystem)
description: |
   Netop is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - OSPath|re:
     - C:\\Program Files\\Danware Data\\NetOp Packn Deploy\\.*
     - .*\\Danware Data\\NetOp Packn Deploy\\.*
     - .*\\Netop Remote Control\\.*

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
