title: RMM Bitvise SSH Server (Pslist)
description: |
   Bitvise SSH Server is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: process_creation
  product: windows
  service: pslist

detection:
  condition: selection
  selection:
   - Image|re:
     - C:\\Program Files\\Bitvise SSH Server\\.*
     - .*\\Bitvise SSH Server\\.*
     - .*\\BvSshServer-Inst.exe

details: Detected RMM process %EventData.Image%
enrichment: |
  x=>dict(
   CallChain=GetCallChain(Pid=x.EventData.Pid),
   ImageHash=x.EventData.Image && hash(path=x.EventData.Image),
   ParentHash=x.EventData.ParentImage && hash(path=x.EventData.ParentImage))
