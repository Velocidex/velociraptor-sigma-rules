title: RMM FleetDeck.io (filesystem)
description: |
   FleetDeck.io is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - fleetdeck_agent_svc.exe
     - fleetdeck_commander_svc.exe
     - fleetdeck_installer.exe
     - fleetdeck_commander_launcher.exe
     - fleetdeck_agent.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
