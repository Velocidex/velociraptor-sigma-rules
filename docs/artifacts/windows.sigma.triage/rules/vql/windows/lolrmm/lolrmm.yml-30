title: RMM mRemoteNG (Pslist)
description: |
   mRemoteNG is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: process_creation
  product: windows
  service: pslist

detection:
  condition: selection
  selection:
   - Image|endswith:
     - \mRemoteNG.exe
     - \c:\Program Files (x86)%\mRemoteNG
   - Image|re:
     - C:\\Program Files (x86)\\mRemoteNG\\.*
     - .*\\mRemoteNG\\.*
     - .*\\mRemoteNG.exe
     - .*%\\mRemoteNG
     - mRemoteNG-Installer-.*.msi
     - .*\\mRemoteNG.exe

details: Detected RMM process %EventData.Image%
enrichment: |
  x=>dict(
   CallChain=GetCallChain(Pid=x.EventData.Pid),
   ImageHash=x.EventData.Image && hash(path=x.EventData.Image),
   ParentHash=x.EventData.ParentImage && hash(path=x.EventData.ParentImage))
