title: RMM BeyondTrust (Bomgar) (filesystem)
description: |
   BeyondTrust (Bomgar) is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - bomgar-scc.exe
     - bomgar-pac.exe
     - bomgar-rdp.exe
   - OSPath|re:
     - bomgar-scc-.*.exe
     - bomgar-pac-.*.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
