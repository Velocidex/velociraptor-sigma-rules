title: RMM N-Able Advanced Monitoring Agent (filesystem)
description: |
   N-Able Advanced Monitoring Agent is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - BASEClient.exe
     - BASupApp.exe
     - BASupSrvc.exe
     - BASupSrvcCnfg.exe
     - BASupTSHelper.exe
   - OSPath|re:
     - Agent_.*_RW.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
