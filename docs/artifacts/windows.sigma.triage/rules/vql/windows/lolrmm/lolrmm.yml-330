title: RMM Splashtop (filesystem)
description: |
   Splashtop is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - strwinclt.exe
   - OSPath|re:
     - C:\\Program Files (x86)\\Splashtop\\.*
     - .*\\Splashtop\\Splashtop Remote\\Client for RMM\\.*

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
