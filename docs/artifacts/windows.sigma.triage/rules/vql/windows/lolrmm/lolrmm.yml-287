title: RMM ShowMyPC (filesystem)
description: |
   ShowMyPC is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - SMPCSetup.exe
     - showmypc.exe
     - smpcsetup.exe
   - OSPath|re:
     - showmypc.*.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
