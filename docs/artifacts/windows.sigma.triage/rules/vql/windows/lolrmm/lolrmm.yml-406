title: RMM Chrome Remote Desktop (filesystem)
description: |
   Chrome Remote Desktop is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - remote_host.exe
     - remoting_host.exe
   - OSPath|re:
     - C:\\Program Files (x86)\\Google\\Chrome Remote Desktop\\.*
     - .*\\Google\\Chrome Remote Desktop\\.*
     - .*\\remoting_host.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
