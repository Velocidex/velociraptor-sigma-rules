title: RMM Weezo (filesystem)
description: |
   Weezo is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - weezohttpd.exe
     - weezo.exe
   - OSPath|re:
     - weezo setup.*.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
