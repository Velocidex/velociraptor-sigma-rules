title: RMM Xeox (filesystem)
description: |
   Xeox is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - xeox-agent_x64.exe
     - xeox_service_windows.exe
     - xeox-agent_x86.exe
   - OSPath|re:
     - xeox-agent_.*.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
