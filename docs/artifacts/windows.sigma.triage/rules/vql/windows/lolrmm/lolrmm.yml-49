title: RMM ManageEngine (Pslist)
description: |
   ManageEngine is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: process_creation
  product: windows
  service: pslist

detection:
  condition: selection
  selection:
   - Image|endswith:
     - \InstallShield Setup.exe
     - \ManageEngine_Remote_Access_Plus.exe
   - Image|re:
     - .*\\dcagentservice.exe
     - C:\\Program Files (x86)\\DesktopCentral_Agent\\bin\\.*
     - .*\\DesktopCentral_Agent\\bin\\.*

details: Detected RMM process %EventData.Image%
enrichment: |
  x=>dict(
   CallChain=GetCallChain(Pid=x.EventData.Pid),
   ImageHash=x.EventData.Image && hash(path=x.EventData.Image),
   ParentHash=x.EventData.ParentImage && hash(path=x.EventData.ParentImage))
