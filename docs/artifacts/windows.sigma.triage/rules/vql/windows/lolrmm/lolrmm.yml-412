title: RMM SecureCRT (filesystem)
description: |
   SecureCRT is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - OSPath|re:
     - C:\\.*\\SecureCRT.EXE
     - .*\\SecureCRT.EXE
     - .*\\VanDyke Software\\ClientPack\\.*

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
