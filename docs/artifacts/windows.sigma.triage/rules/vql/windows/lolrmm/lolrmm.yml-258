title: RMM NateOn-desktop sharing (filesystem)
description: |
   NateOn-desktop sharing is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - nateon.exe
     - nateonmain.exe
   - OSPath|re:
     - nateon.*.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
