title: RMM GoTo Opener (filesystem)
description: |
   GoTo Opener is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - C:\Program Files (x86)\GoTo Opener
   - OSPath|re:
     - .*\\GoTo Opener

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
