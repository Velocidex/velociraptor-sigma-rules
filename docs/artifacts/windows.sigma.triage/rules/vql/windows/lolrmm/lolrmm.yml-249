title: RMM Itarian (filesystem)
description: |
   Itarian is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - ITSMAgent.exe
     - RViewer.exe
     - ItsmRsp.exe
     - RAccess.exe
     - RmmService.exe
     - ITarianRemoteAccessSetup.exe
     - RDesktop.exe
     - ComodoRemoteControl.exe
     - ITSMService.exe
     - RHost.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
