title: RMM Pcvisit (filesystem)
description: |
   Pcvisit is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - pcvisit.exe
     - pcvisit_client.exe
     - pcvisit-easysupport.exe
     - pcvisit_service_client.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
