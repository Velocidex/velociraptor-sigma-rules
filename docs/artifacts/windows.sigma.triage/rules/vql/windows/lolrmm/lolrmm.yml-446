title: RMM Absolute (Computrace) (filesystem)
description: |
   Absolute (Computrace) is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - rpcnet.exe
     - ctes.exe
     - ctespersitence.exe
     - cteshostsvc.exe
     - rpcld.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
