title: RMM IntelliAdmin Remote Control (filesystem)
description: |
   IntelliAdmin Remote Control is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - iadmin.exe
     - intelliadmin.exe
     - agent32.exe
     - agent64.exe
     - agent_setup_5.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
