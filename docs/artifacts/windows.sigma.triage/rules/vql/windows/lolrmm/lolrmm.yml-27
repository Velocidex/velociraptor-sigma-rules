title: RMM ISL Online (Pslist)
description: |
   ISL Online is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: process_creation
  product: windows
  service: pslist

detection:
  condition: selection
  selection:
   - Image|endswith:
     - \isllight.exe
     - \ISLLightClient.exe
     - \ISLLight.exe
     - \isllightservice.exe
     - \islalwaysonmonitor.exe
   - Image|re:
     - .*\\ISLLight.exe
     - C:\\Program Files (x86)\\ISL Online\\ISL Light.*
     - .*\\ISL Online\\ISL Light.*

details: Detected RMM process %EventData.Image%
enrichment: |
  x=>dict(
   CallChain=GetCallChain(Pid=x.EventData.Pid),
   ImageHash=x.EventData.Image && hash(path=x.EventData.Image),
   ParentHash=x.EventData.ParentImage && hash(path=x.EventData.ParentImage))
