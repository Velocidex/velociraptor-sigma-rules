title: RMM Solar-PuTTY (filesystem)
description: |
   Solar-PuTTY is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - OSPath|re:
     - C:\\Program Files\\Solar-Putty-v4\\.*
     - .*\\Solar-Putty-v4\\.*
     - .*\\Solar-PuTTY.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
