title: RMM GotoHTTP (filesystem)
description: |
   GotoHTTP is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - GotoHTTP_x64.exe
     - gotohttp.exe
   - OSPath|re:
     - GotoHTTP.*.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
