title: RMM TeamViewer (Pslist)
description: |
   TeamViewer is a remote monitoring and management (RMM) tool.

logsource:
  category: process_creation
  product: windows
  service: pslist

detection:
  condition: selection
  selection:
   - Image|endswith:
     - \C:\Program Files\TeamViewer\
     - \teamviewer_desktop.exe
     - \teamviewer_service.exe
     - \teamviewerhost

details: Detected RMM process %EventData.Image%
enrichment: |
  x=>dict(
   CallChain=GetCallChain(Pid=x.EventData.Pid),
   ImageHash=x.EventData.Image && hash(path=x.EventData.Image),
   ParentHash=x.EventData.ParentImage && hash(path=x.EventData.ParentImage))
