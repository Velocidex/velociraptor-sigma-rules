title: RMM SmarTTY (filesystem)
description: |
   SmarTTY is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - OSPath|re:
     - c:\\Program Files (x86)\\Sysprogs\\SmarTTY\\.*
     - .*\\Sysprogs\\SmarTTY\\.*
     - .*\\SmarTTY.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
