title: RMM FleetDeck.io (Pslist)
description: |
   FleetDeck.io is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: process_creation
  product: windows
  service: pslist

detection:
  condition: selection
  selection:
   - Image|endswith:
     - \fleetdeck_agent_svc.exe
     - \fleetdeck_commander_svc.exe
     - \fleetdeck_installer.exe
     - \fleetdeck_commander_launcher.exe
     - \fleetdeck_agent.exe

details: Detected RMM process %EventData.Image%
enrichment: |
  x=>dict(
   CallChain=GetCallChain(Pid=x.EventData.Pid),
   ImageHash=x.EventData.Image && hash(path=x.EventData.Image),
   ParentHash=x.EventData.ParentImage && hash(path=x.EventData.ParentImage))
