title: RMM Parallels Access (Pslist)
description: |
   Parallels Access is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: process_creation
  product: windows
  service: pslist

detection:
  condition: selection
  selection:
   - Image|endswith:
     - \TSClient.exe
     - \prl_deskctl_agent.exe
     - \prl_deskctl_wizard.exe
     - \prl_pm_service.exe
   - Image|re:
     - parallelsaccess-.*.exe

details: Detected RMM process %EventData.Image%
enrichment: |
  x=>dict(
   CallChain=GetCallChain(Pid=x.EventData.Pid),
   ImageHash=x.EventData.Image && hash(path=x.EventData.Image),
   ParentHash=x.EventData.ParentImage && hash(path=x.EventData.ParentImage))
