title: RMM Netop Remote Control (aka Impero Connect) (filesystem)
description: |
   Netop Remote Control (aka Impero Connect) is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - nhostsvc.exe
     - nhstw32.exe
     - nldrw32.exe
     - rmserverconsolemediator.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
