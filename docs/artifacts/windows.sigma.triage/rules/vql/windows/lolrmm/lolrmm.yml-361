title: RMM Goverlan (filesystem)
description: |
   Goverlan is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - goverrmc.exe
     - GovAgentInstallHelper.exe
     - GovAgentx64.exe
     - GovReachClient.exe
   - OSPath|re:
     - govsrv.*.exe
     - C:\\Program Files (x86)\\PJ Technologies\\GOVsrv\\.*
     - .*\\PJ Technologies\\GOVsrv\\.*
     - .*\\GovSrv.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
