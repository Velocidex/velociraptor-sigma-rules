title: RMM GoToAssist (filesystem)
description: |
   GoToAssist is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - gotoassist.exe
     - GoTo Assist Opener.exe
   - OSPath|re:
     - g2a.*.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
