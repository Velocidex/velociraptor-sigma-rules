title: RMM NinjaRMM (filesystem)
description: |
   NinjaRMM is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - ninjarmmagent.exe
     - NinjaRMMAgent.exe
     - NinjaRMMAgenPatcher.exe
     - ninjarmm-cli.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
