title: RMM TeamViewer (filesystem)
description: |
   TeamViewer is a remote monitoring and management (RMM) tool.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - C:\Program Files\TeamViewer\
     - teamviewer_desktop.exe
     - teamviewer_service.exe
     - teamviewerhost

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
