title: RMM RemoteUtilities (filesystem)
description: |
   RemoteUtilities is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - rutview.exe
     - rutserv.exe
   - OSPath|re:
     - .*\\Remote Manipulator System - Server\\.*
     - C:\\Program Files\\Remote Utilities\\.*
     - .*\\Remote Utilities\\.*
     - .*\\rutserv.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
