title: RMM FixMe.it (Pslist)
description: |
   FixMe.it is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: process_creation
  product: windows
  service: pslist

detection:
  condition: selection
  selection:
   - Image|endswith:
     - \FixMeit Client.exe
     - \TiExpertStandalone.exe
     - \TiExpertCore.exe
     - \FixMeit Unattended Access Setup.exe
     - \FixMeit Expert Setup.exe
     - \TiExpertCore.exe
     - \fixmeitclient.exe
     - \TiClientCore.exe
     - \9380CC75B872221A7425D7503565B67580407F60
   - Image|re:
     - FixMeitClient.*.exe
     - TiClientHelper.*.exe

details: Detected RMM process %EventData.Image%
enrichment: |
  x=>dict(
   CallChain=GetCallChain(Pid=x.EventData.Pid),
   ImageHash=x.EventData.Image && hash(path=x.EventData.Image),
   ParentHash=x.EventData.ParentImage && hash(path=x.EventData.ParentImage))
