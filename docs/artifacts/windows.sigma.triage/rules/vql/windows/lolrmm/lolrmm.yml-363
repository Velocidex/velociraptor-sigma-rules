title: RMM TightVNC (filesystem)
description: |
   TightVNC is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - tvnviewer.exe
     - tvnserver.exe
   - OSPath|re:
     - TightVNCViewerPortable.*.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
