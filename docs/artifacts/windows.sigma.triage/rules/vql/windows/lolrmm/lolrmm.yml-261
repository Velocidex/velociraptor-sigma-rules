title: RMM ISL Online (filesystem)
description: |
   ISL Online is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - isllight.exe
     - ISLLightClient.exe
     - ISLLight.exe
     - isllightservice.exe
     - islalwaysonmonitor.exe
   - OSPath|re:
     - .*\\ISLLight.exe
     - C:\\Program Files (x86)\\ISL Online\\ISL Light.*
     - .*\\ISL Online\\ISL Light.*

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
