title: RMM Insync (Pslist)
description: |
   Insync is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: process_creation
  product: windows
  service: pslist

detection:
  condition: selection
  selection:
   - Image|endswith:
     - \C:\Users\USERNAME\AppData\Roaming\Insync\App\Insync.exe
   - Image|re:
     - .*Users\\.*\\AppData\\Roaming\\Insync\\App\\Insync.exe
     - .*\\Insync.exe

details: Detected RMM process %EventData.Image%
enrichment: |
  x=>dict(
   CallChain=GetCallChain(Pid=x.EventData.Pid),
   ImageHash=x.EventData.Image && hash(path=x.EventData.Image),
   ParentHash=x.EventData.ParentImage && hash(path=x.EventData.ParentImage))
