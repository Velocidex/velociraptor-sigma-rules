title: RMM N-Able Advanced Monitoring Agent (Pslist)
description: |
   N-Able Advanced Monitoring Agent is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: process_creation
  product: windows
  service: pslist

detection:
  condition: selection
  selection:
   - Image|endswith:
     - \BASEClient.exe
     - \BASupApp.exe
     - \BASupSrvc.exe
     - \BASupSrvcCnfg.exe
     - \BASupTSHelper.exe
   - Image|re:
     - Agent_.*_RW.exe

details: Detected RMM process %EventData.Image%
enrichment: |
  x=>dict(
   CallChain=GetCallChain(Pid=x.EventData.Pid),
   ImageHash=x.EventData.Image && hash(path=x.EventData.Image),
   ParentHash=x.EventData.ParentImage && hash(path=x.EventData.ParentImage))
