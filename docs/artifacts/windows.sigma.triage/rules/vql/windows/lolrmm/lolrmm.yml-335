title: RMM pcAnywhere (filesystem)
description: |
   pcAnywhere is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - awhost32.exe
     - awrem32.exe
     - pcaquickconnect.exe
     - winaw32.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
