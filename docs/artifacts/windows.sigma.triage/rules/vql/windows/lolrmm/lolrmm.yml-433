title: RMM GoToAssist Agent Desktop Console (filesystem)
description: |
   GoToAssist Agent Desktop Console is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - OSPath|re:
     - C:\\.*\\G2RDesktopConsole-x64.msi
     - .*\\G2RDesktopConsole-x64.msi

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
