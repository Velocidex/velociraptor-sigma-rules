title: RMM Total Software Deployment (filesystem)
description: |
   Total Software Deployment is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - OSPath|re:
     - C:\\ProgramData\\Total Software Deployment\\.*
     - .*\\Total Software Deployment\\.*
     - .*\\tniwinagent.exe
     - .*\\Tsdservice.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
