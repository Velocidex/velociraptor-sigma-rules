title: RMM RES Automation Manager (filesystem)
description: |
   RES Automation Manager is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - wmc.exe
     - wmc_deployer.exe
     - wmcsvc.exe
   - OSPath|re:
     - wisshell.*.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
