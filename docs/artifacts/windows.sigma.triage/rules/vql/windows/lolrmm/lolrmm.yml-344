title: RMM Syncthing (filesystem)
description: |
   Syncthing is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - OSPath|re:
     - C:\\Users\\.*\\AppData\\Roaming\\SyncTrayzor\\.*
     - .*Users\\.*\\AppData\\Roaming\\SyncTrayzor\\.*
     - .*\\Syncthing.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
