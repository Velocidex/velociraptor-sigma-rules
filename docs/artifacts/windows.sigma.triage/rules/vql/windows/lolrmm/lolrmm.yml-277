title: RMM SmartFTP (filesystem)
description: |
   SmartFTP is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - C:\Program Files (x86)\SmartFTP Client\en-US\
   - OSPath|re:
     - .*\\SmartFTP Client\\.*
     - .*\\SfShellTools.dll.mui

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
