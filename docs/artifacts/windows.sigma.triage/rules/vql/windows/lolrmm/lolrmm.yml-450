title: RMM Tailscale (filesystem)
description: |
   Tailscale is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - tailscaled.exe
     - tailscale-ipn.exe
   - OSPath|re:
     - tailscale-.*.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
