title: RMM mRemoteNG (filesystem)
description: |
   mRemoteNG is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - mRemoteNG.exe
     - c:\Program Files (x86)%\mRemoteNG
   - OSPath|re:
     - C:\\Program Files (x86)\\mRemoteNG\\.*
     - .*\\mRemoteNG\\.*
     - .*\\mRemoteNG.exe
     - .*%\\mRemoteNG
     - mRemoteNG-Installer-.*.msi
     - .*\\mRemoteNG.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
