title: RMM RemotePC (filesystem)
description: |
   RemotePC is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - Idrive.File-Transfer
     - remotepcservice.exe
     - RemotePC.exe
     - remotepchost.exe
     - idrive.RemotePCAgent
     - rpcsuite.exe
     - RemotePCService.exe
   - OSPath|re:
     - C:\\Program Files (x86)\\RemotePC\\.*
     - .*\\RemotePC\\.*
     - .*\\RemotePCService.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
