title: RMM S3 Browser (filesystem)
description: |
   S3 Browser is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - OSPath|re:
     - C:\\Program Files (x86)\\S3 Browser\\.*
     - .*\\S3 Browser\\.*
     - .*\\s3browser.*.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
