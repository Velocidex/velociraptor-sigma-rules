title: RMM WinSCP (filesystem)
description: |
   WinSCP is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - OSPath|re:
     - C:\\Users\\IEUser\\Downloads\\WinSCP-5.21.6-Portable\\.*
     - .*\\WinSCP.*Portable\\.*
     - .*\\WinSCP.exe
     - .*\\WinSCP\\.*

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
