title: RMM Domotz (filesystem)
description: |
   Domotz is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - domotz.exe
     - Domotz Pro Desktop App.exe
     - domotz_bash.exe
   - OSPath|re:
     - domotz.*.exe
     - Domotz Pro Desktop App Setup.*.exe
     - domotz-windows.*.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
