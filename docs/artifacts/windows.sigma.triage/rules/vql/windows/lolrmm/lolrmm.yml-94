title: RMM Mocha VNC Lite (Pslist)
description: |
   Mocha VNC Lite is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: process_creation
  product: windows
  service: pslist

detection:
  condition: selection
  selection:
   - Image|endswith:
     - \This installs a modified VNC and cannot be blocked by path separate from VNC
     - \This installs a modified VNC and cannot be blocked by path separate from VNC
   - Image|re:
     - .*\\RealVNC\\VNC4\\.*

details: Detected RMM process %EventData.Image%
enrichment: |
  x=>dict(
   CallChain=GetCallChain(Pid=x.EventData.Pid),
   ImageHash=x.EventData.Image && hash(path=x.EventData.Image),
   ParentHash=x.EventData.ParentImage && hash(path=x.EventData.ParentImage))
