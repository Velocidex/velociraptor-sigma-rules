title: RMM GatherPlace-desktop sharing (filesystem)
description: |
   GatherPlace-desktop sharing is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - gp3.exe
     - gp4.exe
     - gp5.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
