title: RMM Xshell (filesystem)
description: |
   Xshell is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - OSPath|re:
     - C:\\Program Files (x86)\\NetSarang\\xShell\\.*
     - .*\\NetSarang\\xShell\\.*
     - .*\\xShell.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
