title: RMM Ultra VNC (filesystem)
description: |
   Ultra VNC is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - OSPath|re:
     - C:\\Program Files\\uvnc bvba\\UltraVNC\\.*
     - .*\\uvnc bvba\\UltraVNC\\.*
     - .*\\UVNC_Launch.exe
     - .*\\winvnc.exe
     - .*\\vncviewer.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
