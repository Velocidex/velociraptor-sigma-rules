title: RMM Laplink Everywhere (filesystem)
description: |
   Laplink Everywhere is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - laplink.exe
     - laplinkeverywhere.exe
     - llrcservice.exe
     - serverproxyservice.exe
     - OOSysAgent.exe
   - OSPath|re:
     - laplink-everywhere-setup.*.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
