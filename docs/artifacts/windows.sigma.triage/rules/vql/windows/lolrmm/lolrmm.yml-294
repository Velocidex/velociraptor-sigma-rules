title: RMM Free Tools Launcher (filesystem)
description: |
   Free Tools Launcher is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - OSPath|re:
     - C:\\Program Files\\ManageEngine\\ManageEngine Free Tools\\Launcher\\.*
     - .*\\ManageEngine\\.*

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
