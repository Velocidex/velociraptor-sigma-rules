title: RMM SimpleHelp (filesystem)
description: |
   SimpleHelp is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - simplehelpcustomer.exe
     - simpleservice.exe
     - simplegatewayservice.exe
     - remote access.exe
     - windowslauncher.exe
     - spsrv.exe
     - serviceconfig.xml

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
