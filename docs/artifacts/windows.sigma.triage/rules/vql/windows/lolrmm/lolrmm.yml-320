title: RMM Seetrol (filesystem)
description: |
   Seetrol is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - seetrolcenter.exe
     - seetrolclient.exe
     - seetrolmyservice.exe
     - seetrolremote.exe
     - seetrolsetting.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
