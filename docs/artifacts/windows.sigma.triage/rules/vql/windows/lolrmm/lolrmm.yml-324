title: RMM Xpra (filesystem)
description: |
   Xpra is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - OSPath|re:
     - C:\\Program Files (x86)\\Xpra\\.*
     - .*\\Xpra\\.*
     - .*\\Xpra-Launcher.exe
     - .*\\Xpra-x86_64_Setup.exe

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
