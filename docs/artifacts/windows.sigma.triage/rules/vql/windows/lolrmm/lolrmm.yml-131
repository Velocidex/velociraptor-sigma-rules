title: RMM LANDesk (Pslist)
description: |
   LANDesk is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: process_creation
  product: windows
  service: pslist

detection:
  condition: selection
  selection:
   - Image|endswith:
     - \issuser.exe
     - \landeskagentbootstrap.exe
     - \LANDeskPortalManager.exe
     - \ldinv32.exe
     - \ldsensors.exe
   - Image|re:
     - C:\\Program Files (x86)\\LANDesk\\.*
     - .*\\LANDesk\\.*
     - .*\\issuser.exe
     - .*\\softmon.exe
     - .*\\tmcsvc.exe

details: Detected RMM process %EventData.Image%
enrichment: |
  x=>dict(
   CallChain=GetCallChain(Pid=x.EventData.Pid),
   ImageHash=x.EventData.Image && hash(path=x.EventData.Image),
   ParentHash=x.EventData.ParentImage && hash(path=x.EventData.ParentImage))
