title: RMM GoToAssist (GoTo Resolve) (filesystem)
description: |
   GoToAssist (GoTo Resolve) is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - OSPath|re:
     - C:\\ProgramFiles.*\\GoTo Machine Installer\\.*
     - .*\\GoTo Machine Installer\\.*
     - .*\\GoTo\\.*

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
