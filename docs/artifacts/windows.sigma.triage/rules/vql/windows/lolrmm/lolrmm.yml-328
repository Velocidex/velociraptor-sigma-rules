title: RMM Mocha VNC Lite (filesystem)
description: |
   Mocha VNC Lite is a remote monitoring and management (RMM) tool. More information will be added as it becomes available.

logsource:
  category: filesystem
  product: windows
  service: glob

detection:
  condition: selection
  selection:
   - Name:
     - This installs a modified VNC and cannot be blocked by path separate from VNC
     - This installs a modified VNC and cannot be blocked by path separate from VNC
   - OSPath|re:
     - .*\\RealVNC\\VNC4\\.*

details: Detected RMM executable %EventData.OSPath%
enrichment: |
  x=>dict(
   Hash=hash(path=x.EventData.OSPath))
